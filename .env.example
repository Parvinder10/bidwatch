# ==============================================================================
# BIDWATCH: Environment Configuration Template
# Copy this file to .env and configure your environment-specific settings.
# Do NOT commit secrets or live production credentials to version control.
# ==============================================================================

# Backend API Base URL (used by frontend to communicate with procurement backend)
# Local development: http://localhost:8000
# Production cloud backend: https://your-backend-service.onrender.com
API_BASE_URL=http://localhost:8000

# Relational Database Connection URL
# Local default: sqlite:///data/processed/bidwatch.db
# Production PostgreSQL example: postgresql://username:password@hostname:5432/bidwatch
DATABASE_URL=sqlite:///data/processed/bidwatch.db

# CORS Allowed Origins (Comma-separated list of permitted web frontend domains)
# Example: https://bidwatch.vercel.app,https://bidwatch-parvinder10s-projects.vercel.app,http://localhost:3000
CORS_ORIGINS=https://bidwatch.vercel.app,https://bidwatch-parvinder10s-projects.vercel.app,http://localhost:3000,http://localhost:8000

# Backend Server Host & Port
HOST=0.0.0.0
PORT=8000

# Streamlit Configuration (Optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
